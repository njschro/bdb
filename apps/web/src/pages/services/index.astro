---
// Foundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Kicker from "@/components/fundations/elements/Kicker.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

// Sections
import Principles from "@/components/services/Principles.astro";
import Testimonials from "@/components/customers/Testimonials.astro";

// Components
import ServiceCard from "@/components/services/ServiceCard.astro";

// Content
import { getAllServices } from "@/lib/data";
const services = await getAllServices();
---

<BaseLayout navTransparent={true}>
  <section class="bg-base-50 lg:border-b lg:border-berg-blue">
    <Wrapper
      variant="standard"
      class="py-12 pt-48 lg:border-x lg:border-berg-blue"
    >
      <div class="grid grid-cols-1 lg:grid-cols-3 lg:items-end gap-12">
        <div class="max-w-4xl text-balance lg:col-span-2">
          <Kicker class="text-berg-red">Services</Kicker>
          <Text
            tag="h1"
            variant="displayMD"
            class="font-medium tracking-wide mt-12 text-berg-blue"
          >
            Construction services delivered with clarity, discipline, and
            experience.
          </Text>
          <Text tag="p" variant="textLG" class="text-base-500 mt-4">
            We provide end-to-end construction and renovation services across
            residential and commercial projects.
          </Text>
        </div>
      </div>
    </Wrapper>
  </section>

  <section>
    <Wrapper variant="standard" class="py-24 lg:border-x lg:border-berg-blue">
      <Kicker class="text-berg-red mb-12">Search for a specific service</Kicker>
      <!-- Search Input UI -->
      <div class="mb-16 max-w-xl">
        <label for="service-search" class="sr-only">Search Services</label>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <svg class="h-5 w-5 text-base-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
            </svg>
          </div>
          
          <input
            type="search"
            id="service-search"
            class="block w-full pl-10 pr-3 py-3 border border-berg-blue/20 leading-5 bg-transparent placeholder-base-500 focus:outline-none focus:ring-1 focus:ring-berg-blue focus:border-berg-blue sm:text-sm transition-colors"
            placeholder="Search for a service (e.g., Concrete, Remodeling)..."
          />
        </div>
      </div>

      <!-- Services Grid -->
      <div id="services-grid" class="grid grid-cols-1 lg:grid-cols-3 gap-x-8 gap-y-24">
        {services.map((service) => (
          <div class="service-item">
            <ServiceCard service={service} />
          </div>
        ))}
      </div>

      <!-- No Results State -->
      <div id="no-results" class="hidden py-12 text-center">
        <Text tag="p" variant="textLG" class="text-base-500">
          We couldn't find a service matching your search. Try a different term or <a href="apps/web/src/pages/contact.astro" target="_blank"> contact us</a> to discuss your project.
        </Text>
      </div>

    </Wrapper>
  </section>
  <Principles />
  <Testimonials />
</BaseLayout>

<script>
  // Astro bundles this script and runs it on the client
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('service-search');
    const serviceItems = document.querySelectorAll('.service-item');
    const noResults = document.getElementById('no-results');

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        // @ts-ignore
        const searchTerm = e.target.value.toLowerCase();
        let visibleCount = 0;

        serviceItems.forEach((item) => {
          // Searches all text inside the component (title, summary, body copy)
          const textContent = item.textContent?.toLowerCase() || '';
          
          if (textContent.includes(searchTerm)) {
            // @ts-ignore
            item.style.display = 'block';
            visibleCount++;
          } else {
            // @ts-ignore
            item.style.display = 'none';
          }
        });

        // Toggle the "No Results" message
        if (noResults) {
          if (visibleCount === 0) {
            noResults.classList.remove('hidden');
          } else {
            noResults.classList.add('hidden');
          }
        }
      });
    }
  });
</script>