---
import BlogLayout from "@/layouts/BlogLayout.astro";
import { getNewsStaticPaths, getNewsBySlug, USE_SANITY } from "@/lib/data";
import { render } from "astro:content";

export async function getStaticPaths() {
  return getNewsStaticPaths();
}

const { slug } = Astro.params;
const result = await getNewsBySlug(slug!);
if (!result) return Astro.redirect("/404");

const { article, htmlContent, _entry } = result as any;

let Content: any = null;
if (!USE_SANITY && _entry) {
  const rendered = await render(_entry);
  Content = rendered.Content;
}
---

<BlogLayout frontmatter={article.data}>
  {/* Apply the prose styles directly to the content generation layer */}
  <div class="prose prose-lg prose-headings:text-berg-blue prose-p:text-base-600 prose-a:text-berg-red hover:prose-a:text-accent-500 max-w-none mx-auto">
    {USE_SANITY ? <Fragment set:html={htmlContent} /> : Content && <Content />}
  </div>
</BlogLayout>