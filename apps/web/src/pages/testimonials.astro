---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Kicker from "@/components/fundations/elements/Kicker.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Star from "@/components/fundations/icons/Star.astro";
import { Image } from "astro:assets";

// Data
// FIX: Removed "sanity:client" and replaced it with your new data function!
import { getAllTestimonials } from "@/lib/data";

// Fetch Testimonials from your central data utility
const testimonials = await getAllTestimonials();
---

<BaseLayout navTransparent={true}>
  <section class="bg-base-50 lg:border-b lg:border-berg-blue">
    <Wrapper
      variant="standard"
      class="py-12 pt-48 lg:border-x lg:border-berg-blue"
    >
      <div class="grid grid-cols-1 lg:grid-cols-3 lg:items-end gap-12">
        <div class="max-w-4xl text-balance lg:col-span-2">
          <Kicker class="text-berg-red">Testimonials</Kicker>
          <Text
            tag="h1"
            variant="displayMD"
            class="font-medium tracking-tight mt-12 text-berg-blue"
          >
            Hear it first from the families and businesses we've worked for
          </Text>
          <Text tag="p" variant="textLG" class="text-base-500 mt-4">
            We build spaces and relationships tailored to your vision—to endure for generations. And we treat every project as if we are building for our own family. We're thorough and build with love. 
          </Text>
        </div>
      </div>
    </Wrapper>
  </section>
  <section>
    <Wrapper variant="standard" class="py-12 lg:py-24 lg:border-x lg:border-berg-blue">
      <div class="space-y-8 lg:space-y-24 mt-12 lg:mt-24">
        {
          testimonials.map((testimonial: any) => {
            const anchorId = testimonial.clientName?.toLowerCase().replace(/[^a-z0-9]+/g, '-') || "testimonial";
            
            return (
              <article id={anchorId} class="relative group bg-base-50 grid grid-cols-1 lg:grid-cols-3 gap-4">
                {testimonial.clientImage?.url && (
                  <Image
                    src={testimonial.clientImage.url}
                    alt={`${testimonial.clientName} testimonial`}
                    width={800}
                    height={600}
                    loading="eager"
                    decoding="async"
                    class="object-cover object-center w-full aspect-square scroll-mt-24"
                  />
                )}
                <div class="lg:col-span-2 p-8 grid grid-cols-1 gap-8 lg:grid-cols-3">
                  <div class="flex flex-col h-full justify-between lg:col-span-2 gap-8">
                    <blockquote>
                      {/* Star Rating Render */}
                      {testimonial.rating !== undefined && (
                        <div class="flex items-center gap-1 mb-4">
                          {Array.from({ length: 5 }).map((_, i) => (
                            <Star 
                              aria-hidden="true" 
                              class={`size-6 ${i < testimonial.rating ? "text-berg-red" : "text-base-200"}`} 
                            />
                          ))}
                        </div>
                      )}
                      <Text
                        tag="p"
                        variant="textLG"
                        class="text-base-900 font-medium leading-relaxed"
                      >
                        "{testimonial.quote}"
                      </Text>
                    </blockquote>
                    <div>
                      <Text
                        tag="p"
                        variant="textXL"
                        class="text-base-900 font-display"
                      >
                        {testimonial.clientName}
                      </Text>
                      {testimonial.role && (
                        <Text tag="p" variant="textSM" class="text-base-600 mt-1">
                          {testimonial.role}
                        </Text>
                      )}
                    </div>
                  </div>
                  
                  {/* Metrics Block (Conditional if provided) */}
                  {(testimonial.metric || testimonial.metricLabel) && (
                    <div class="lg:border-l lg:pl-8 flex flex-col h-full border-base-100 order-first lg:order-none">
                      {testimonial.metric && (
                        <Text
                          tag="p"
                          variant="displayXL"
                          class="text-base-900 font-display mt-auto"
                        >
                          {testimonial.metric}
                        </Text>
                      )}
                      {testimonial.metricLabel && (
                        <div class="pt-4 mt-4 border-t border-base-100">
                          <Text
                            tag="h3"
                            variant="textBase"
                            class="text-base-900 font-medium"
                          >
                            {testimonial.metricLabel}
                          </Text>
                        </div>
                      )}
                    </div>
                  )}
                </div>
              </article>
            );
          })
        }
      </div>
    </Wrapper>
  </section>
</BaseLayout>