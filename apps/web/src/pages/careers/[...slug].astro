---
import CareersLayout from "@/layouts/CareersLayout.astro";
import { getCareerStaticPaths, getCareerBySlug, USE_SANITY } from "@/lib/data";
import { render } from "astro:content";

export async function getStaticPaths() {
  return getCareerStaticPaths();
}

const { slug } = Astro.params;
const result = await getCareerBySlug(slug!);
if (!result) return Astro.redirect("/404");

const { career, htmlContent, _entry } = result;

let Content: any = null;
if (!USE_SANITY && _entry) {
  const rendered = await render(_entry);
  Content = rendered.Content;
}
---

<CareersLayout frontmatter={career.data}>
  {USE_SANITY ? <Fragment set:html={htmlContent} /> : Content && <Content />}
</CareersLayout>
