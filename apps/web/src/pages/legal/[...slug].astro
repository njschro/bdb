---
import LegalLayout from "@/layouts/LegalLayout.astro";
import {
  getLegalStaticPaths,
  getLegalPageBySlug,
  USE_SANITY,
} from "@/lib/data";
import { render } from "astro:content";

export async function getStaticPaths() {
  return getLegalStaticPaths();
}

const { slug } = Astro.params;
const result = await getLegalPageBySlug(slug!);
if (!result) return Astro.redirect("/404");

const { page, htmlContent, _entry } = result;

let Content: any = null;
if (!USE_SANITY && _entry) {
  const rendered = await render(_entry);
  Content = rendered.Content;
}
---

<LegalLayout frontmatter={page.data}>
  {USE_SANITY ? <Fragment set:html={htmlContent} /> : Content && <Content />}
</LegalLayout>
