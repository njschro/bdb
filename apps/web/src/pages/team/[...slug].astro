---
import TeamLayout from "@/layouts/TeamLayout.astro";
import {
  getTeamStaticPaths,
  getTeamMemberBySlug,
  USE_SANITY,
} from "@/lib/data";
import { render } from "astro:content";

export async function getStaticPaths() {
  return getTeamStaticPaths();
}

const { slug } = Astro.params;
const result = await getTeamMemberBySlug(slug!);
if (!result) return Astro.redirect("/404");

const { member, htmlContent, _entry } = result;

let Content: any = null;
if (!USE_SANITY && _entry) {
  const rendered = await render(_entry);
  Content = rendered.Content;
}
---

<TeamLayout frontmatter={member.data}>
  {USE_SANITY ? <Fragment set:html={htmlContent} /> : Content && <Content />}
</TeamLayout>
