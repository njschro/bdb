---
import BlogLayout from "@/layouts/BlogLayout.astro";
import { getPostStaticPaths, getPostBySlug, USE_SANITY } from "@/lib/data";
import { render } from "astro:content";

export async function getStaticPaths() {
  return getPostStaticPaths();
}

const { slug } = Astro.params;
const result = await getPostBySlug(slug!);
if (!result) return Astro.redirect("/404");

const { post, htmlContent, _entry } = result as any;

// For Content Collections, render the entry directly in the page
let Content: any = null;
if (!USE_SANITY && _entry) {
  const rendered = await render(_entry);
  Content = rendered.Content;
}
---

<BlogLayout frontmatter={post.data}>
  {USE_SANITY ? <Fragment set:html={htmlContent} /> : Content && <Content />}
</BlogLayout>
