---
const { variant, size, class: className = "w-full h-full", ...rest } = Astro.props;
const xs = ["size-3"];
const sm = ["size-4"];
const base = ["size-5"];
const md = ["size-6"];
const lg = ["size-7"];
const xl = ["size-8"];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 11 13"
  fill="currentColor"
  class:list={[
    "icon",
    size === "xs" && xs,
    size === "sm" && sm,
    size === "base" && base,
    size === "md" && md,
    size === "lg" && lg,
    size === "xl" && xl,
    className,
  ]}
  {...rest}
  ><g><g><g><path d="M5.939,2.39l-4.454,0c-0.543,0 -0.99,0.447 -0.99,0.99l0,7.919c0,0.543 0.447,0.99 0.99,0.99l5.939,0c0.543,0 0.99,-0.447 0.99,-0.99l0,-6.434l-2.475,-2.475Z" style="fill:none;fill-rule:nonzero;stroke:#0e2166;stroke-width:0.99px;"/><path d="M5.444,2.39l0,1.98c0,0.543 0.447,0.99 0.99,0.99l1.98,0m-5.444,3.465l2.97,0" style="fill:none;fill-rule:nonzero;stroke:#0e2166;stroke-width:0.99px;stroke-linecap:square;stroke-linejoin:miter;"/></g><g><circle cx="6.167" cy="4.598" r="2.741" style="fill:#ed1c24;"/><path d="M6.167,1.25c1.848,0 3.348,1.5 3.348,3.348c0,1.848 -1.5,3.348 -3.348,3.348c-1.848,0 -3.348,-1.5 -3.348,-3.348c0,-1.848 1.5,-3.348 3.348,-3.348Zm0,0.607c-1.513,0 -2.741,1.228 -2.741,2.741c0,1.513 1.228,2.741 2.741,2.741c1.513,0 2.741,-1.228 2.741,-2.741c0,-1.513 -1.228,-2.741 -2.741,-2.741Z" style="fill:#fff;"/><path d="M6.239,0.848l0,3.633" style="fill:none;stroke:#fff;stroke-width:0.94px;stroke-linecap:square;stroke-linejoin:miter;stroke-miterlimit:1.5;"/><path d="M8.892,4.637c0.172,0 0.313,-0.14 0.296,-0.311c-0.148,-1.47 -1.321,-2.643 -2.791,-2.79c-0.171,-0.017 -0.311,0.124 -0.311,0.296l0,2.494c0,0.171 0.141,0.312 0.312,0.312l2.494,-0Z" style="fill:#ed1c24;fill-rule:nonzero;stroke:#fff;stroke-width:0.62px;stroke-linecap:square;stroke-linejoin:miter;"/></g></g></g></svg
