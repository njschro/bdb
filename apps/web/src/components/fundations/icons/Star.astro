---
const { variant, size, class: className, ...rest } = Astro.props;
const xs = ["size-3"];
const sm = ["size-4"];
const base = ["size-5"];
const md = ["size-6"];
const lg = ["size-7"];
const xl = ["size-8"];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 253 241"
  fill="currentColor"
  class:list={[
    "icon",
    size === "xs" && xs,
    size === "sm" && sm,
    size === "base" && base,
    size === "md" && md,
    size === "lg" && lg,
    size === "xl" && xl,
    className,
  ]}
  {...rest}
>
  <g transform="matrix(1,0,0,1,-307.395523,-7.747481)">
        <g transform="matrix(1,0,0,1,306,0)">
            <g transform="matrix(1.162365,0,0,1.162365,-398.026088,-23.922189)">
                <path d="M452.407,27.246L478.087,106.278L561.186,106.278L493.957,155.123L519.637,234.156L452.407,185.311L385.178,234.156L410.857,155.123L343.628,106.278L426.728,106.278L452.407,27.246Z"/>
            </g>
        </g>
    </g></svg
>
