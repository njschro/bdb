---
const { variant, size, class: className = "w-full h-full", ...rest } = Astro.props;
const xs = ["size-3"];
const sm = ["size-4"];
const base = ["size-5"];
const md = ["size-6"];
const lg = ["size-7"];
const xl = ["size-8"];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 12 16"
  fill="currentColor"
  class:list={[
    "icon",
    size === "xs" && xs,
    size === "sm" && sm,
    size === "base" && base,
    size === "md" && md,
    size === "lg" && lg,
    size === "xl" && xl,
    className,
  ]}
  {...rest}
  ><g><g><path d="M4.13,8.868l0,-0.576m0,4.033l0,-1.152m0,-5.186l0,-0.576m2.305,-2.305l0,2.305c0,0.632 0.52,1.152 1.152,1.152l2.305,0" style="fill:none;fill-rule:nonzero;stroke:#0e2166;stroke-width:0.95px;"/><path d="M7.299,14.63l1.44,0c0.632,0 1.152,-0.52 1.152,-1.152l0,-7.49l-2.881,-2.881l-5.186,0c-0.632,0 -1.152,0.52 -1.152,1.152l0,9.219c0,0.205 0.055,0.405 0.158,0.582" style="fill:none;fill-rule:nonzero;stroke:#0e2166;stroke-width:0.95px;stroke-linecap:square;"/><circle cx="4.13" cy="13.478" r="1.152" style="fill:none;stroke:#0e2166;stroke-width:0.95px;"/></g><circle id="circle-small.svg" cx="8.074" cy="3.665" r="3.226" style="fill:#ed1c24;stroke:#fff;stroke-width:0.88px;"/><g><path d="M6.516,3.72c-0.013,-0.035 -0.013,-0.074 0,-0.109c0.26,-0.63 0.877,-1.043 1.559,-1.043c0.681,0 1.299,0.413 1.559,1.043c0.013,0.035 0.013,0.074 0,0.109c-0.26,0.63 -0.877,1.043 -1.559,1.043c-0.681,0 -1.299,-0.413 -1.559,-1.043" style="fill:none;fill-rule:nonzero;stroke:#fff;stroke-width:0.43px;"/><circle cx="8.074" cy="3.665" r="0.471" style="fill:none;stroke:#fff;stroke-width:0.43px;"/></g></g></svg
>
