---
const { variant, size, class: className = "w-full h-full", ...rest } = Astro.props;
const xs = ["size-3"];
const sm = ["size-4"];
const base = ["size-5"];
const md = ["size-6"];
const lg = ["size-7"];
const xl = ["size-8"];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 12 14"
  fill="currentColor"
  class:list={[
    "icon",
    size === "xs" && xs,
    size === "sm" && sm,
    size === "base" && base,
    size === "md" && md,
    size === "lg" && lg,
    size === "xl" && xl,
    className,
  ]}
  {...rest}
  ><g><g><path d="M8.153,11.729c0,-1.778 -1.463,-3.241 -3.241,-3.241c-1.778,0 -3.241,1.463 -3.241,3.241" style="fill:none;fill-rule:nonzero;stroke:#16266a;stroke-width:0.81px;"/><circle cx="4.912" cy="6.462" r="2.026" style="fill:none;stroke:#16266a;stroke-width:0.81px;"/><path d="M9.774,11.324c0,-1.365 -0.81,-2.634 -1.621,-3.241c0.51,-0.382 0.81,-0.983 0.81,-1.62c0,-0.714 -0.378,-1.378 -0.992,-1.742" style="fill:none;fill-rule:nonzero;stroke:#16266a;stroke-width:0.81px;"/></g><path id="message-square.svg" d="M10.828,4.052c0,0.342 -0.281,0.623 -0.623,0.623l-3.74,0l-1.247,1.247l0,-4.987c0,-0.342 0.281,-0.623 0.623,-0.623l4.364,0c0.342,0 0.623,0.281 0.623,0.623l0,3.117Z" style="fill:#ee2b33;fill-rule:nonzero;stroke:#fff;stroke-width:0.62px;stroke-linecap:round;stroke-linejoin:round;"/></g></svg
>
