---
const { variant, size, class: className = "w-full h-full", ...rest } = Astro.props;
const xs = ["size-3"];
const sm = ["size-4"];
const base = ["size-5"];
const md = ["size-6"];
const lg = ["size-7"];
const xl = ["size-8"];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 11 16"
  fill="currentColor"
  class:list={[
    "icon",
    size === "xs" && xs,
    size === "sm" && sm,
    size === "base" && base,
    size === "md" && md,
    size === "lg" && lg,
    size === "xl" && xl,
    className,
  ]}
  {...rest}
  ><path id="lightbulb.svg" d="M6.304,9.846c0.124,-0.622 0.436,-1.058 0.934,-1.556c0.622,-0.56 0.934,-1.369 0.934,-2.178c0,-2.049 -1.686,-3.734 -3.734,-3.734c-2.049,-0 -3.734,1.686 -3.734,3.734c0,0.622 0.124,1.369 0.934,2.178c0.436,0.436 0.809,0.934 0.934,1.556m0,2.49l3.734,0m-3.112,2.49l2.49,0" style="fill:none;fill-rule:nonzero;stroke:#16266a;stroke-width:0.99px;"/><path id="sparkles.svg" d="M5.337,5.659c-0.071,-0.281 -0.286,-0.501 -0.561,-0.573l-2.394,-0.631c-0.084,-0.024 -0.142,-0.103 -0.142,-0.192c0,-0.089 0.058,-0.168 0.142,-0.192l2.394,-0.631c0.275,-0.072 0.49,-0.292 0.561,-0.573l0.617,-2.447c0.024,-0.086 0.101,-0.146 0.188,-0.146c0.087,0 0.164,0.06 0.188,0.146l0.617,2.447c0.071,0.281 0.286,0.501 0.561,0.573l2.394,0.631c0.084,0.024 0.143,0.103 0.143,0.192c0,0.089 -0.059,0.168 -0.143,0.192l-2.394,0.631c-0.275,0.072 -0.49,0.292 -0.561,0.573l-0.617,2.447c-0.024,0.086 -0.101,0.146 -0.188,0.146c-0.087,0 -0.164,-0.06 -0.188,-0.146l-0.617,-2.447Zm3.926,-4.985l0,1.595m0.78,-0.798l-1.561,0m-5.462,4.786l-0,0.798m0.39,-0.399l-0.78,0" style="fill:#ee2b33;fill-rule:nonzero;stroke:#fff;stroke-width:0.55px;stroke-linecap:round;"/></svg
