---
const { variant, size, class: className, ...rest } = Astro.props;
const xs = ["size-3"];
const sm = ["size-4"];
const base = ["size-5"];
const md = ["size-6"];
const lg = ["size-7"];
const xl = ["size-8"];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 232 239"
  fill="currentColor"
  class:list={[
    "icon",
    size === "xs" && xs,
    size === "sm" && sm,
    size === "base" && base,
    size === "md" && md,
    size === "lg" && lg,
    size === "xl" && xl,
    className,
  ]}
  {...rest}
>
<g transform="matrix(1,0,0,1,-321.14768,1.265328)">
        <g transform="matrix(1,0,0,1,306,0)">
            <g id="arrow-down-narrow-wide.svg" transform="matrix(9.759636,0,0,9.759636,27.458116,78.940344)">
                <path d="M11,4L15,4M11,8L18,8M11,12L21,12" style="fill:none;fill-rule:nonzero;stroke:rgb(14,33,102);stroke-width:2px;"/>
            </g>
        </g>
        <g transform="matrix(1,0,0,1,306,0)">
            <g id="arrow-down-up.svg" transform="matrix(-9.978692,0.150991,-0.150991,-9.978692,167.157344,234.913803)">
                <path d="M2.996,16.189L6.728,19.647L10.863,16.314M6.728,19.021L6.955,3.999" style="fill:none;fill-rule:nonzero;stroke:rgb(237,28,36);stroke-width:2px;stroke-linejoin:miter;"/>
            </g>
        </g>
    </g></svg
>
