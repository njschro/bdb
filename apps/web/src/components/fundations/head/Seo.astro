---
import { AstroSeo } from "@lexingtonthemes/seo";

interface Props {
  title?: string;
  description?: string;
  image?: {
    url: string;
    alt?: string;
  };
  type?: "website" | "article";
  publishedTime?: string;
  noindex?: boolean;
}

const {
  title: pageTitle,
  description: pageDescription,
  image: pageImage,
  type = "website",
  publishedTime,
  noindex = false,
} = Astro.props;

// Site defaults - customize these for your site
const siteDefaults = {
  title: "Bastion",
  description: "Construction & Engineering Excellence",
  siteUrl: import.meta.env.SITE || "https://example.com",
  twitterHandle: "",
};

// Use page-specific values or fall back to site defaults
const title = pageTitle
  ? `${pageTitle} | ${siteDefaults.title}`
  : siteDefaults.title;
const description = pageDescription || siteDefaults.description;
const siteUrl = siteDefaults.siteUrl;
const canonical = new URL(Astro.url.pathname, siteUrl).toString();

// Image: use page image if provided
const ogImageUrl = pageImage?.url || "";
const ogImageAlt = pageImage?.alt || title;

const twitterHandle = siteDefaults.twitterHandle;
---

<AstroSeo
  title={title}
  description={description}
  canonical={canonical}
  noindex={noindex}
  openGraph={{
    url: canonical,
    title: title,
    description: description,
    images: ogImageUrl
      ? [
          {
            url: ogImageUrl,
            width: 1200,
            height: 630,
            alt: ogImageAlt,
            type: "image/jpeg",
          },
        ]
      : [],
    site_name: siteDefaults.title,
    type: type,
    locale: "en_US",
    ...(type === "article" &&
      publishedTime && {
        article: {
          publishedTime: publishedTime,
        },
      }),
  }}
  twitter={{
    handle: twitterHandle,
    site: twitterHandle,
    cardType: ogImageUrl ? "summary_large_image" : "summary",
  }}
/>
