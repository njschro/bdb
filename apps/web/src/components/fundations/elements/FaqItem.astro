---
import Expand from '@/components/fundations/icons/Expand.astro';
import Collapse from '@/components/fundations/icons/Collapse.astro';

interface Props {
  question: string;
  answer: string;
}

const { question, answer } = Astro.props;
---

<div class="faq-item group border-b border-accent-100 py-8">
  <div class="flex items-start justify-between gap-6">
    <h3 class="text-xl md:text-2xl font-bold text-accent-900 pr-4">
      {question}
    </h3>
    
    <button
      type="button"
      class="faq-toggle shrink-0 flex items-center justify-center w-10 h-10 rounded-full bg-white shadow-md text-accent-900 transition-all duration-300 hover:bg-accent-900 hover:text-white active:scale-95 relative"
      aria-expanded="false"
    >
      <div class="expand-icon absolute inset-0 flex items-center justify-center transition-opacity duration-300">
        <Expand size="sm" />
      </div>
      <div class="collapse-icon absolute inset-0 flex items-center justify-center opacity-0 transition-opacity duration-300">
        <Collapse size="sm" />
      </div>
    </button>
  </div>

  <div class="faq-answer max-h-0 overflow-hidden transition-all duration-500 ease-in-out">
    <div class="pt-6 text-lg text-accent-700 leading-relaxed">
      {answer}
    </div>
  </div>
</div>

<script>
  // Only run on client-side
  if (typeof window !== 'undefined') {
    const faqItems = document.querySelectorAll('.faq-item');

    faqItems.forEach((item) => {
      const button = item.querySelector('.faq-toggle');
      const answer = item.querySelector('.faq-answer');
      const expandIcon = item.querySelector('.expand-icon');
      const collapseIcon = item.querySelector('.collapse-icon');

      if (button && answer && expandIcon && collapseIcon) {
        button.addEventListener('click', () => {
          const isOpen = button.getAttribute('aria-expanded') === 'true';
          
          // Toggle state
          button.setAttribute('aria-expanded', (!isOpen).toString());
          
          // Toggle Icons
          expandIcon.classList.toggle('opacity-0');
          collapseIcon.classList.toggle('opacity-0');

          // Toggle Answer Height
          if (!isOpen) {
            answer.style.maxHeight = answer.scrollHeight + "px";
          } else {
            answer.style.maxHeight = "0px";
          }
        });
      }
    });
  }
</script>