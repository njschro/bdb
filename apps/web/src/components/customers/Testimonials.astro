---
// Astro
import { Image } from "astro:assets";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Kicker from "@/components/fundations/elements/Kicker.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import ArrowLeft from "@/components/fundations/icons/ArrowLeft.astro";
import ArrowRight from "@/components/fundations/icons/ArrowRight.astro";
import Star from "@/components/fundations/icons/Star.astro";

// Fetch Sanity Testimonials
import { getAllTestimonials } from "@/lib/data";
const testimonials = await getAllTestimonials();
---

<section class="overflow-hidden">
  <Wrapper variant="standard" class="py-24 lg:border-x lg:border-berg-blue">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <Kicker class="text-berg-red text-balance tracking-wide">
        Trusted by families and businesses
      </Kicker>

      <div class="lg:col-span-2">
        <Text
          tag="h2"
          variant="displayMD"
          class="font-medium tracking-tight text-balance"
        >
          Building on integrity and building to last, one family and business at a time.
        </Text>
        
        {/* NEW: Added 'testimonials-nav' ID to hide the entire block if slider is locked */}
        <div id="testimonials-nav" class="flex items-center gap-2 mt-8">
          <Button
            iconOnly
            size="xs"
            variant="muted"
            aria-label="Previous testimonial"
            id="testimonials-previous"
          >
            <ArrowLeft size="sm" slot="icon" />
          </Button>
          <Button
            iconOnly
            size="xs"
            variant="muted"
            aria-label="Next testimonial"
            id="testimonials-next"
          >
            <ArrowRight size="sm" slot="icon" />
          </Button>
        </div>
      </div>
    </div>
    
    <div id="testimonials-slider" class="keen-slider mt-12">
      {
        testimonials.map((testimonial) => (
          <article class="keen-slider__slide">
            <div class="group relative h-full overflow-hidden transition duration-300 ">
              <div class="relative aspect-3/4 overflow-hidden bg-base-100">
                {testimonial.clientImage?.url && (
                  <img
                    width="500"
                    height="800"
                    src={testimonial.clientImage.url}
                    alt={`${testimonial.clientName} portrait`}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                  />
                )}
                
                <div class="absolute inset-0 flex flex-col justify-between bg-accent-900 p-8 opacity-0 transition duration-300 group-hover:opacity-100">
                  <div class="flex items-center gap-1 ">
                    {Array.from({ length: 5 }).map((_, index) => (
                      <Star 
                        aria-hidden="true" 
                        class={`size-4 ${index < (testimonial.rating ?? 5) ? "text-accent-400" : "text-accent-400/30"}`} 
                      />
                    ))}
                  </div>
                  <Text
                    tag="blockquote"
                    variant="textSM"
                    class="text-base-300 lg:text-lg leading-relaxed mt-4 line-clamp-6"
                  >
                    {testimonial.quote}
                  </Text>
                </div>
              </div>
              <div class=" mt-2">
                <Text
                  tag="p"
                  variant="textBase"
                  class="text-accent-900 font-medium "
                >
                  {testimonial.clientName}
                </Text>
                {testimonial.role && (
                  <Text
                    tag="p"
                    variant="textSM"
                    class="text-base-500 font-medium"
                  >
                    {testimonial.role}
                  </Text>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </Wrapper>
</section>

<script lang="js">
  import KeenSlider from "keen-slider";
  import "keen-slider/keen-slider.min.css";

  let sliderInstance = null;

  function initSlider() {
    const sliderElement = document.getElementById("testimonials-slider");
    if (!sliderElement) return;

    if (sliderInstance) {
      sliderInstance.destroy();
      sliderInstance = null;
    }

    const slideCount = sliderElement.children.length;
    if (slideCount === 0) return;

    sliderInstance = new KeenSlider(sliderElement, {
      // Loop natively ONLY if slide count strictly exceeds max visible slides
      loop: slideCount > 3,
      renderMode: "performance",
      slides: {
        perView: 1,
        spacing: 16,
      },
      breakpoints: {
        "(min-width: 768px)": {
          slides: { perView: Math.min(2, slideCount), spacing: 24 },
          loop: slideCount > 2,
        },
        "(min-width: 1024px)": {
          slides: { perView: Math.min(3, slideCount), spacing: 32 },
          loop: slideCount > 3,
        },
      },
    });

    // Custom navigation wrap-around logic to handle loop-disabled edge cases seamlessly
    const prevBtn = document.getElementById("testimonials-previous");
    const nextBtn = document.getElementById("testimonials-next");

    if (prevBtn) {
      prevBtn.onclick = () => {
        if (!sliderInstance) return;
        const current = sliderInstance.track.details.rel;
        if (current === 0 && slideCount <= 3) {
          sliderInstance.moveToIdx(slideCount - 1);
        } else {
          sliderInstance.prev();
        }
      };
    }

    if (nextBtn) {
      nextBtn.onclick = () => {
        if (!sliderInstance) return;
        const current = sliderInstance.track.details.rel;
        if (current === slideCount - 1 && slideCount <= 3) {
          sliderInstance.moveToIdx(0);
        } else {
          sliderInstance.next();
        }
      };
    }
  }

  initSlider();
  document.addEventListener("astro:page-load", initSlider);
</script>