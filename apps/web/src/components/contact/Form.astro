---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Kicker from "@/components/fundations/elements/Kicker.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import MapPin from "@/components/fundations/icons/MapPin.astro";
import Phone from "@/components/fundations/icons/Phone.astro";
import Envelpe from "@/components/fundations/icons/Envelope.astro";

const contactDetails = {
  email: "info@bergdbuilding.com",
  phone: "+1 (419) 969-2374",
  address: "421 Independence Dr., Suite B\nNapoleon, OH 43545",
};

const contactItems = [
  {
    label: "Address",
    value: contactDetails.address.split("\n"),
    icon: "location",
  },
  {
    label: "Phone",
    value: [contactDetails.phone],
    href: `tel:${contactDetails.phone.replace(/[^\d+]/g, "")}`,
    icon: "phone",
  },
  {
    label: "Email",
    value: [contactDetails.email],
    href: `mailto:${contactDetails.email}`,
    icon: "mail",
  },
];
---

<section>
  <Wrapper variant="standard" class="py-24 lg:border-x lg:border-berg-blue">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <div>
        <Kicker class="text-berg-red">Visit Us</Kicker>
        <Text
          tag="h2"
          variant="displaySM"
          class="font-medium tracking-tight text-berg-blue mt-12 text-balance"
        >
          We're ready to help you build things to last.
        </Text>
        <Text tag="p" variant="textLG" class="text-base-600 mt-4">
          Whether you have a question about your project, want more details about our services, or want to discuss a potential collaboration, we're here to help. Fill
          out the form or give us a call and we'll respond as soon as possible.
        </Text>
        <div class="mt-12 space-y-8 border-t border-base-200 pt-8">
          {
            contactItems.map((item) => (
              <div class="flex items-start gap-4">
                <span class="flex size-10 items-center justify-center bg-accent-500/10 text-accent-600">
                  {item.icon === "location" ? (
                    <MapPin size="sm" class="text-accent-500" />
                  ) : item.icon === "phone" ? (
                    <Phone size="sm" class="text-accent-500" />
                  ) : (
                    <Envelpe size="sm" class="text-accent-500" />
                  )}
                </span>
                <div class="space-y-1">
                  <Text
                    tag="p"
                    variant="textBase"
                    class="font-medium  text-base-900"
                  >
                    {item.label}
                  </Text>
                  <Text
                    tag="p"
                    variant="textBase"
                    class="text-base-700 leading-relaxed"
                  >
                    {item.value.map((line, index) => (
                      <>
                        {item.href ? (
                          <a
                            href={
                              Array.isArray(item.href)
                                ? item.href[index] || item.href[0]
                                : item.href
                            }
                            class="transition-colors hover:text-accent-500"
                          >
                            {line}
                          </a>
                        ) : (
                          line
                        )}
                        {index < item.value.length - 1 ? <br /> : ""}
                      </>
                    ))}
                  </Text>
                </div>
              </div>
            ))
          }
        </div>
      </div>
      
      <form action="https://api.web3forms.com/submit" method="POST" class="bg-accent-50 p-8 lg:p-12 lg:border lg:border-berg-blue">
        <Text
          tag="h3"
          variant="textLG"
          class="font-medium tracking-tight text-berg-blue"
        >
          Send us a message
        </Text>
        <Text tag="p" variant="textBase" class="text-base-600 mt-1 mb-8">
          Share a few details and our team will reach out within one business day.
        </Text>

        <input type="hidden" name="access_key" value="b1a2499b-0ab1-452a-a384-bed276897bb1">
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-6">
          <div class="space-y-1">
            <label for="first-name" class="text-sm text-base-900 block">First Name</label>
            <input
              id="first-name"
              type="text"
              name="first_name"
              required
              class="w-full bg-transparent border-0 border-b border-berg-blue px-0 py-2 text-base-900 focus:ring-0 focus:border-b-2 focus:border-berg-blue transition-all"
            />
          </div>
          
          <div class="space-y-1">
            <label for="last-name" class="text-sm text-base-900 block">Last Name</label>
            <input
              id="last-name"
              type="text"
              name="last_name"
              required
              class="w-full bg-transparent border-0 border-b border-berg-blue px-0 py-2 text-base-900 focus:ring-0 focus:border-b-2 focus:border-berg-blue transition-all"
            />
          </div>

          <div class="space-y-1">
            <label for="contact-email" class="text-sm text-base-900 block">E-mail address</label>
            <input
              id="contact-email"
              type="email"
              name="email"
              required
              class="w-full bg-transparent border-0 border-b border-berg-blue px-0 py-2 text-base-900 focus:ring-0 focus:border-b-2 focus:border-berg-blue transition-all"
            />
          </div>

          <div class="space-y-1">
            <label for="contact-phone" class="text-sm text-base-900 block">Phone (Optional)</label>
            <input
              id="contact-phone"
              type="tel"
              name="phone"
              class="w-full bg-transparent border-0 border-b border-berg-blue px-0 py-2 text-base-900 focus:ring-0 focus:border-b-2 focus:border-berg-blue transition-all"
            />
          </div>
        </div>

        <div class="space-y-2 mt-8">
          <label for="contact-message" class="text-sm text-base-900 block">Your Message</label>
          <textarea
            id="contact-message"
            name="message"
            rows="5"
            required
            class="w-full bg-transparent border border-berg-blue p-4 text-base-900 focus:ring-0 focus:border-2 focus:border-berg-blue transition-all"
          ></textarea>
        </div>

        <Button size="lg" type="submit" variant="primary" class="w-full mt-8 bg-berg-blue text-white hover:bg-berg-blue/90">
          Submit
        </Button>
      </form>
    </div>
  </Wrapper>
</section>