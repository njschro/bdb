---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
// Content
const { title, description, url, image, alt } = {
  url: "/blog/posts/" + Astro.props.post.slug,
  title: Astro.props.post.data.title,
  description: Astro.props.post.data.description,
  image: Astro.props.post.data.image.url,
  alt: Astro.props.post.data.image.alt || Astro.props.post.data.title,
};
// Integrations: calculate reading time
import readingTime from "reading-time";

const timeToRead = readingTime(Astro.props.post.body || "");
---

<article class="relative flex flex-col group">
  <a
    href={url}
    title={`Read more: ${title}`}
    aria-label={`Read blog post: ${title}`}
    class="absolute inset-0 z-10"></a>
  <img
    src={image}
    alt={alt}
    width="1000"
    height="100"
    loading="lazy"
    decoding="async"
    class="object-cover object-center w-full aspect-square"
  />
  <div class="mt-4">
    <Text tag="p" variant="textXS" class="text-base-600 uppercase">
      {timeToRead.text}
    </Text>
    <Text tag="h3" variant="textSM" class="font-medium text-base-900 mt-4"
      >{title}</Text
    >
    <Text tag="p" variant="textSM" class="text-base-600 mt-1"
      >{description}</Text
    >
  </div>
</article>
