---
// Assets
import { Image } from "astro:assets";
import CtaImage from "@/images/assets/cta.png";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Button from "@/components/fundations/elements/Button.astro";
---

<section>
  <Wrapper variant="standard" class="py-12 lg:py-24 lg:border-x lg:border-berg-blue">
    <div class="bg-accent-700 flex flex-col lg:flex-row">
      <div class="lg:w-2/3 p-8 lg:p-20">
        <Text
          tag="p"
          variant="textXS"
          class="text-base-300 uppercase font-medium"
        >
          we are here for you
        </Text>
        <Text
          tag="h2"
          variant="display2XL"
          class="text-white font-display tracking-tight text-balance mt-12"
        >
          Ready to start your renovation?
        </Text>
        <Text
          tag="p"
          variant="textBase"
          class="text-base-300 leading-relaxed mt-4 max-w-xl text-balance"
        >
          Let’s bring your space to life with craftsmanship, clarity, and care.
          Whether it’s a full remodel or a custom home build, Rosewood makes the
          process smooth, transparent, and beautifully executed.
        </Text>
        <div class="space-y-1 mt-12">
          <a
            href="/free-quote"
            class="w-fit text-white block hover:text-base-500 duration-300"
          >
            Request free Quote
          </a>

          <a
            href="/contact"
            class="w-fit text-white block hover:text-base-500 duration-300"
          >
            Contact us
          </a>
        </div>
      </div>
      <Image
        src={CtaImage}
        alt="Berg Design + Build Home Improvement"
        class="aspect-4/3 order-first object-cover object-bottom lg:order-last w-full lg:w-1/3"
      />
    </div>
  </Wrapper>
</section>
