---
// Assets
import { Image } from "astro:assets";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import UnderlinedLink from "@/components/fundations/elements/UnderlinedLink.astro";
// Content
const { title, description, url, image } = {
  url: "/services/" + Astro.props.service.slug,
  title: Astro.props.service.data.title,
  description: Astro.props.service.data.description,
  image: Astro.props.service.data.image.url,
};
---

<article class="relative">
  <!-- Invisible overlay link covering the whole card -->
  <a
    href={url}
    title={`View service: ${title}`}
    aria-label={`View service: ${title}`}
    class="absolute inset-0 z-10"
  ></a>

  <Image
    src={image}
    alt={title}
    width={800}
    height={700}
    loading="lazy"
    decoding="async"
    class="object-cover object-center w-full aspect-4/3"
  />
  
  <div class="mt-4">
    <Text tag="h3" variant="textXL" class="font-medium text-accent-900">
      {title}
    </Text>
    <Text tag="p" variant="textBase" class="text-base-600 mt-1 line-clamp-2">
      {description}
    </Text>
    
    <!-- z-20 pushes this link above the invisible overlay so hover states still trigger -->
    <UnderlinedLink
      href={url}
      variant="dark"
      title={`View service: ${title}`}
      aria-label={`View service: ${title}`}
      class="mt-4 relative z-20"
    >
      Read further
    </UnderlinedLink>
  </div>
</article>