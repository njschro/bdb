---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Kicker from "@/components/fundations/elements/Kicker.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import ServiceCard from "@/components/services/ServiceCard.astro";
// Content
import { getAllServices } from "@/lib/data";
const services = await getAllServices();
const focusAreas = [
  {
    title: "Residential Construction",
    description:
      "From new home construction to complex additions and renovations, we craft tailored living spaces aligned with your precise lifestyle and standards.",
  },
  {
    title: "Commercial Projects",
    description:
      "Robust steel, metal, and masonry construction executed with stringent project management to deliver commercial structures that elevate business operations.",
  },
];
---

<section class=" relative lg:border-y lg:border-berg-blue bg-base-200">
    <div class="absolute inset-x-0 top-0 h-52 bg-gradient-to-b from-base-50 to-transparent pointer-events-none" aria-hidden="true"></div>
  <Wrapper variant="standard" class="relative py-24 lg:border-x lg:border-berg-blue">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <Kicker class="text-berg-red">What we build and how we deliver</Kicker>
      <div class="lg:col-span-2 text-balance">
        <Text
          tag="h1"
          variant="displayMD"
          class="font-medium tracking-wide text-balance text-berg-blue"
        >
          Thoughtfully planned construction services, built on integrity and built to last.
        </Text>
        <Text tag="p" variant="textLG" class="text-base-600 mt-4">
          From renovations to full builds, we manage the details—so you know what's happening and what's next.
        </Text>
        <Button
          isLink
          size="lg"
          variant="accent"
          href="/services"
          class="mt-8 w-fit">See all services</Button
        >
      </div>
          </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mt-12 lg:mt-24 lg:p-1.5">
      {
        focusAreas.map((area) => (
          <div>
            <Text
              tag="h3"
              variant="textXL"
              class="text-accent-900 font-medium "
            >
              {area.title}
            </Text>
            <Text tag="p" variant="textLG" class="text-base-600 mt-2">
              {area.description}
            </Text>
          </div>
        ))
      }
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-3 mt-12 gap-x-8 gap-y-12">
      {services.slice(0, 3).map((service) => <ServiceCard service={service} />)}
    </div>
  </Wrapper>
</section>
