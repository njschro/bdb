---
// Assets
import Logo from "@/components/assets/Logo.astro";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Kicker from "@/components/fundations/elements/Kicker.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const principles = [
  {
    title: "Plan with clarity and honesty",
    description:
      "We define scope, timelines, and responsibilities upfront—so decisions stay simple and projects stay on track.",
  },
  {
    title: "Build with safety and quality",
    description:
      "Safety isn’t paperwork. It’s how we run the site: dependable tools, expert supervision, and zero shortcuts.",
  },
  {
    title: "Own the outcome",
    description:
      "We take accountability from first briefing to handover, solving problems early and communicating openly.",
  },
  {
    title: "Improve the craft",
    description:
      "We believe in developing our people. Investing time in honing their skills and communication helps us perfect your vision.",
  },
];
---

<section class="bg-base-100 relative overflow-hidden lg:border-y lg:border-berg-blue">
  <Wrapper
    variant="standard"
    class="py-24 lg:py-48 lg:border-x lg:border-berg-blue"
  >
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <div>
        <Logo class="h-34 text-white" /><Kicker class="text-berg-red mt-8"
          >Our principles</Kicker
        >
      </div>

      <div class="lg:col-span-2 text-balance">
        <Text tag="h2" variant="displayLG" class="text-base-400 font-medium">
          We uphold our strict standards across 
          <span class="text-berg-blue"> planning</span>, 
          <span class="text-berg-blue"> construction</span>, and
          <span class="text-berg-blue"
            > final delivery</span> on <span class="text-berg-blue"
            >every project 
          </span>
        </Text>

        <Text tag="p" variant="textLG" class="text-base-500 mt-4">
          Our standards are modeled on our two core pillars: <span class="text-berg-red">Built on Integrity, Built to Last.</span>
        </Text>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-24 mt-12">
          {
            principles.map(({ title, description }) => (
              <div>
                <Text
                  tag="h3"
                  variant="displayXS"
                  class="font-medium uppercase  text-berg-red"
                >
                  {title}
                </Text>
                <Text tag="p" variant="textBase" class="text-base-500 mt-2">
                  {description}
                </Text>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </Wrapper>
</section>
