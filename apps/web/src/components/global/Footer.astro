---
// Assets
import Logo from "@/components/assets/Logo.astro";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Content
import { getAllServices } from "@/lib/data";

type LinkItem = {
  label: string;
  href: string;
};

type LinkSection = {
  title: string;
  links: LinkItem[];
};

const allServices = await getAllServices();
const services = allServices
  .sort((a, b) => a.data.title.localeCompare(b.data.title))
  .slice(0, 6);

const linkSections: LinkSection[] = [
  {
    title: "Company",
    links: [
      { label: "About", href: "/about" },
      { label: "Why Us", href: "/why-us" },
      { label: "Partners", href: "/partners" },
      { label: "Mission", href: "/mission-vision" },
    ],
  },
  {
    title: "Services",
    links: services.map((service) => ({
      label: service.data.title,
      href: `/services/${service.slug}`,
    })),
  },
  {
    title: "Resources",
    links: [
      { label: "Projects", href: "/projects" },
      { label: "News", href: "/news" },
      { label: "Careers", href: "/careers" },
      { label: "Team", href: "/team" },
      { label: "Privacy", href: "/privacy" },
    ],
  },
];

const contactDetails = {
  email: "info@bergdbuilding.com",
  phone: "+1 (419) 969-2374",
  address: "421 Independence Dr., Suite B\nNapoleon, OH 43545",
  hours: ["Mon-Fri: 8:00 AM - 4:00 PM", "Sat-Sun: By appointment"],
};

const legalLinks: LinkItem[] = [
  { label: "Privacy", href: "/legal/privacy" },
  { label: "Terms", href: "/legal/terms" },
  { label: "Cookies", href: "/legal/cookies" },
];
---

<footer class="relative isolate overflow-hidden bg-accent-950 text-base-800 lg:border-y lg:border-berg-blue">
  <div class="absolute inset-0 z-0 pointer-events-none">
    <video autoplay muted loop playsinline class="size-full object-cover">
      <source src="/video/BergHeroIntro.mp4" type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-base-50/75"></div>
    <div aria-hidden="true" class="absolute pointer-events-none inset-x-0 top-0 h-1/2 bg-linear-to-b from-white to-transparent"></div>
  </div>

  <Wrapper
    variant="standard"
    class="relative z-10 lg:border-berg-blue py-8 border-b lg:border-x"
  >
  
    <div
      class="flex flex-col gap-8 p-8 lg:flex-row lg:items-end lg:justify-between lg:border lg:border-berg-blue bg-base-50"
    >
      <div class="max-w-xl text-balance">
        <Logo class="h-36 text-white" />

        <Text tag="p" variant="textXL" class="text-berg-red font-medium mt-24">
          Built on Integrity. Built to Last.
        </Text>
      </div>
      <div class="flex flex-wrap gap-2 sm:items-center">
        <Button
          isLink
          size="xs"
          variant="accent"
          href={`mailto:${contactDetails.email}`}
        >
          {contactDetails.email}
        </Button>
        <Button
          isLink
          size="xs"
          variant="muted"
          href={`tel:${contactDetails.phone.replace(/[^\d+]/g, "")}`}
        >
          {contactDetails.phone}
        </Button>
      </div>
    </div>
  </Wrapper>
  <Wrapper
    variant="standard"
    class="relative py-8 lg:border-x lg:border-berg-blue space-y-12 z-10"
  >
    <div class="grid gap-x-8 sm:grid-cols-2 lg:grid-cols-4 gap-y-24">
      {
        linkSections.map((section) => (
          <div>
            <Text
              tag="p"
              variant="textXS"
              class="uppercase font-medium  text-berg-blue"
            >
              {section.title}
            </Text>
            <div class="space-y-2 text-sm mt-12">
              {section.links.map((link) => (
                <a
                  href={link.href}
                  class="block text-base-700 transition hover:text-accent-300 w-fit"
                >
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        ))
      }

      <div>
        <Text tag="p" variant="textXS" class="uppercase font-medium text-berg-blue">
          Contact
        </Text>
        <div class="mt-12">
          <Text tag="p" variant="textSM" class="text-base-700"
            >{contactDetails.hours[0]}</Text
          >
          <Text tag="p" variant="textSM" class="text-base-700"
            >{contactDetails.hours[1]}</Text
          >
          <address>
            <p class="whitespace-pre-line leading-relaxed mt-2">
              {contactDetails.address}
            </p>
          </address>
        </div>
      </div>
    </div>

    <div class="border-t border-white/10 pt-8">
      <div
        class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between"
      >
        <Text tag="p" variant="textSM" class="text-base-700">
          © {new Date().getFullYear()} Berg Design + Build. All rights reserved.
        </Text>
        <div class="flex flex-wrap gap-4 text-berg-blue text-sm">
          {
            legalLinks.map((link) => (
              <a href={link.href} class="hover:text-accent-300 transition">
                {link.label}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </Wrapper>
</footer>