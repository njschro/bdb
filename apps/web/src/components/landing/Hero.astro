---
import { Image } from "astro:assets";
import heroImage from "@/images/assets/heroImage.png";

// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "../fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import GoogleBadge from "@/components/fundations/elements/GoogleBadge.astro";
import BBBBadge from "@/components/fundations/elements/BBBBadge.astro";
import FacebookBadge from "@/components/fundations/elements/FacebookBadge.astro";

// 1. Logic: Explicitly map the badges to their own types
const stats = [
  { 
    type: "bbb" 
  },
  { 
    type: "google", 
    rating: "5.0", 
    reviewsCount: "2", 
    businessUrl: "https://maps.app.goo.gl/bGRS26EsW7Vdb4zEA" 
  },
  { 
    type: "facebook", 
    rating: "5.0", 
    reviewsCount: "1", 
    pageUrl: "https://www.facebook.com/profile.php?id=61570964104530" 
  },
];
---
<section class="relative min-h-[90dvh] flex flex-col">
  <div class="absolute inset-0 z-0">
    <video autoplay muted loop playsinline class="size-full object-cover">
      <source src="/video/BergHeroIntro.mp4" type="video/mp4" />
    </video>
    <div aria-hidden="true" class="absolute pointer-events-none inset-0 bg-accent-100/60"></div>
    <div aria-hidden="true" class="absolute pointer-events-none inset-x-0 bottom-0 h-1/2 bg-linear-to-t from-accent-50 to-transparent"></div>
  </div>

  <div class="relative z-10 flex-1 flex flex-col">
    <Wrapper variant="standard" class="flex-1 flex flex-col justify-end py-12 lg:pb-12 pt-24 lg:border-x lg:border-berg-blue" >
      <div class="max-w-x2 text-balance">
        <Text tag="h1" variant="displayLG" class="text-berg-blue tracking-wide mt-12">
          Built on Integrity. Built to Last.
        </Text>
        <Text tag="p" variant="textXL" class="text-base-800 max-w-x2 mt-4">
          With a 30-year legacy of integrity, quality, and community, we are Northwest Ohio's newly founded company for residential and commercial construction.
        </Text>
      </div>
      <div class="flex flex-row justify-start lg:mr-auto lg:max-w-3x1 gap-4">
        <Button
          isLink
          size="xl"
          variant="accent"
          href="/contact"
          class="w-fit mt-8"
        >
          Start Your Project
        </Button>
        <Button
          isLink
          size="xl"
          variant="accent"
          href="/contact"
          class="w-fit mt-8"
        >
          Call Us
        </Button>
        </div>
    </Wrapper>

    <div class="relative z-10 border-t border-berg-blue">
      <Wrapper variant="standard" class="py-8 lg:border-x lg:border-berg-blue">
        <!-- 
          Unified Horizontal Row: Aligns 3 equal squares horizontally on mobile, leaving space on desktop for custom grid alignment. This took a while...
        -->
        <div class="flex flex-row justify-start gap-6 lg:max-w-3xl lg:ml-auto items-center md:grid md:grid-cols-3 md:gap-x-8">
          {
            stats.map((stat) => (
              <>
                {stat.type === "bbb" && (
                  <div class="flex justify-center md:justify-start">
                    <BBBBadge />
                  </div>
                )}
                
                {stat.type === "google" && (
                  <div class="flex justify-center md:justify-start">
                    <GoogleBadge rating={stat.rating} reviewsCount={stat.reviewsCount} businessUrl={stat.businessUrl} />
                  </div>
                )}

                {stat.type === "facebook" && (
                  <div class="flex justify-center md:justify-start">
                    <FacebookBadge rating={stat.rating} reviewsCount={stat.reviewsCount} pageUrl={stat.pageUrl} />
                  </div>
                )}
              </>
            ))
          }
        </div>
      </Wrapper>
    </div>
  </div>
</section>
