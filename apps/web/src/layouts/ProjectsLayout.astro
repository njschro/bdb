---
// Assets
import { Image } from "astro:assets";
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Star from "@/components/fundations/icons/Star.astro";
// Components
import MainCta from "@/components/ctas/MainCta.astro";
import BeforeAfter from "@/components/projects/BeforeAfter.astro";
import ProjectCard from "@/components/projects/ProjectCard.astro";
import Kicker from "@/components/fundations/elements/Kicker.astro";
// Data
import { getAllProjects, USE_SANITY } from "@/lib/data";
import { portableTextToHtml } from "@/lib/sanity/portableText";
import type { PortableTextBlock } from "@portabletext/types";

// Types
interface Props {
  frontmatter: {
    title: string;
    service: string;
    location?: string;
    duration?: string;
    description: string;
    image: {
      url: string | ImageMetadata;
      alt: string;
    };
    gallery?: Array<{
      url: string | ImageMetadata;
      alt: string;
    }>;
    clientName?: string;
    clientQuote?: string;
    clientRating?: number;
    clientImage?: string | ImageMetadata;
    completedAt?: Date;
    status?: string; // <-- Added status field
  };
  portableTextBody?: PortableTextBlock[];
}

const { frontmatter, portableTextBody } = Astro.props;
const allProjects = await getAllProjects();
const otherProjects = allProjects.filter(
  (project) => project.data.title !== frontmatter.title,
);

// Render Sanity Portable Text if applicable
let sanityHtml = "";
if (USE_SANITY && portableTextBody) {
  sanityHtml = portableTextToHtml(portableTextBody);
}
---

<BaseLayout navTransparent={true}>
  <section>
    <section>
      <Wrapper variant="standard" class="pt-62 pb-12 border-b lg:border-x lg:border-berg-blue">
        <div class="lg:col-span-8">
          <Kicker
            class="text-berg-red uppercase tracking-wide"
            >Project
          </Kicker>
          <Text
            tag="h1"
            variant="displayXL"
            class="text-berg-blue leading-none font-display mt-12"
          >
            {frontmatter.title}
          </Text>
          <Text
            tag="p"
            variant="textLG"
            class="leading-relaxed text-balance text-base-600 mt-4"
          >
            {frontmatter.description}
          </Text>
        </div>
        <dl
          class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-8 mt-12 lg:max-w-xl"
        >
          <div>
            <dt>
              <Text
                tag="h3"
                variant="textXS"
                class="text-berg-blue uppercase tracking-wide"
              >
                Service
              </Text>
            </dt>
            <dd>
              <Text tag="p" variant="textSM" class="text-base-600 mt-1">
                {frontmatter.service}
              </Text>
            </dd>
          </div>
          <div>
            <dt>
              <Text
                tag="h3"
                variant="textXS"
                class="text-berg-blue uppercase tracking-wide"
              >
                Location
              </Text>
            </dt>
            <dd>
              <Text tag="p" variant="textSM" class="text-base-600 mt-1">
                {frontmatter.location}
              </Text>
            </dd>
          </div>
          <div>
            <dt>
              <Text
                tag="h3"
                variant="textXS"
                class="text-berg-blue uppercase tracking-wide"
              >
                Duration
              </Text>
            </dt>
            <dd>
              <Text tag="p" variant="textSM" class="text-base-600 mt-1">
                {frontmatter.duration}
              </Text>
            </dd>
          </div>
          <div>
            <dt>
              <Text
                tag="h3"
                variant="textXS"
                class="text-berg-blue uppercase tracking-wide"
              >
                Status
              </Text>
            </dt>
            <dd>
              <Text tag="p" variant="textSM" class="text-base-600 mt-1 capitalize">
                {/* Check for Sanity status first, fallback to completedAt, or default to Complete */}
                {frontmatter.status || (frontmatter.completedAt
                  ? new Date(frontmatter.completedAt).toLocaleDateString(
                      "en-US",
                      { year: "numeric", month: "long" },
                    )
                  : "Complete")}
              </Text>
            </dd>
          </div>
        </dl>
      </Wrapper>
      <section>
        <Wrapper variant="standard" class="pb-24 pt-8 lg:border-x lg:border-berg-blue">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-y-12 lg:gap-x-8">
            <div class="lg:col-span-8">
              <div>
                {
                  /* 1. Check if gallery exists AND has at least 2 images */
                  frontmatter.gallery && frontmatter.gallery.length >= 2 ? (
                    <div class="space-y-4">
                      <BeforeAfter
                        beforeImage={frontmatter.gallery[0]}
                        afterImage={frontmatter.gallery[1]}
                      />
                      {frontmatter.gallery.length > 2 && (
                        <div class="grid gap-4 sm:grid-cols-2">
                          {frontmatter.gallery.slice(2).map((media) => (
                            <div class="aspect-4/3 overflow-hidden">
                              <Image
                                src={media.url}
                                alt={media.alt || frontmatter.title}
                                width={800}
                                height={600}
                                class="object-cover w-full h-full hover:scale-105 transition-transform duration-500"
                              />
                            </div>
                          ))}
                        </div>
                      )}
                    </div>
                  ) : /* 2. Fallback if gallery exists but has only 1 image */
                  frontmatter.gallery && frontmatter.gallery.length > 0 ? (
                    <div class="grid gap-4 sm:grid-cols-2">
                      {frontmatter.gallery.map((media) => (
                        <div class="aspect-[4/3] overflow-hidden">
                          <Image
                            src={media.url}
                            alt={media.alt || frontmatter.title}
                            width={800}
                            height={600}
                            class="object-cover w-full h-full hover:scale-105 transition-transform duration-500"
                          />
                        </div>
                      ))}
                    </div>
                  ) : /* 3. Render nothing if gallery is undefined */
                  null
                }
              </div>
              <Wrapper variant="prose" class="mt-12">
                {
                  USE_SANITY && sanityHtml ? (
                    <Fragment set:html={sanityHtml} />
                  ) : (
                    <slot />
                  )
                }
              </Wrapper>
            </div>
            <aside class="lg:col-span-4 lg:sticky lg:top-24 h-fit space-y-12">
              <div class="flex justify-start lg:justify-end w-full">
                <div>
                  {
                    frontmatter.clientImage && (
                      <Image
                        src={frontmatter.clientImage}
                        alt={frontmatter.clientName || "Client"}
                        width={400}
                        height={600}
                        class="w-full aspect-9/12 object-cover object-top"
                      />
                    )
                  }
                  <div class="mt-2">
                    {
                      frontmatter.clientRating !== undefined && (
                        <div class="flex items-center gap-1 mb-4 mt-6">
                          {Array.from({ length: 5 }).map((_, i) => (
                            <Star 
                              aria-hidden="true" 
                              class={`size-5 ${i < frontmatter.clientRating! ? "text-berg-red" : "text-base-200"}`} 
                            />
                          ))}
                        </div>
                      )
                    }
                    <Text
                      tag="blockquote"
                      variant="textMD"
                      class="text-base-600"
                    >
                      {frontmatter.clientQuote}
                    </Text>
                    <Text
                      tag="p"
                      variant="textXS"
                      class="text-berg-blue font-medium mt-4 text-right"
                    >
                      <span class="text-berg-red">—</span> {frontmatter.clientName}
                    </Text>
                  </div>
                </div>
              </div>
            </aside>
          </div>
        </Wrapper>
      </section>
    </section>
    <MainCta />
  </section>
</BaseLayout>