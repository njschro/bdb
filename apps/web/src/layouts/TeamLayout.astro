---
// Assets

// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Kicker from "@/components/fundations/elements/Kicker.astro";
import UnderlinedLink from "@/components/fundations/elements/UnderlinedLink.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Content
const { frontmatter } = Astro.props;
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="py-24 lg:pt-48">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="lg:p-20 bg-base-50">
          <Kicker class="text-berg-red"> {frontmatter.role}</Kicker>
          <Text
            tag="h1"
            variant="displayMD"
            class="font-medium tracking-tight mt-12 text-berg-blue"
          >
            {frontmatter.name}
          </Text>
          <Text tag="p" variant="textBase" class="text-base-600 mt-4">
            {frontmatter.bio}
          </Text>
          
          <!-- Added prose and max-w-none to format the markdown slot -->
          <div class="prose prose-base max-w-none mt-12 leading-relaxed text-base-700">
            <slot />
          </div>
          
          <div class="flex items-center gap-6 mt-4 text-base-600">
            {
              frontmatter.socials?.map((social) => (
                <UnderlinedLink variant="dark" href={social.href}>
                  {social.label}
                </UnderlinedLink>
              ))
            }
          </div>
        </div>
        <img
          alt={frontmatter.image.alt}
          src={frontmatter.image.url}
          width={1400}
          height={1400}
          loading="lazy"
          decoding="async"
          class="object-cover object-top aspect-9/12"
        />
      </div>
    </Wrapper>
  </section>
</BaseLayout>